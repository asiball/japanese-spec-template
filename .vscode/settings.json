{
	// Tinymist(Typst 拡張)のエディタ内プレビューを、コンテナ内のビルドと
	// 同じ条件で動かすための設定。Tinymist は拡張に同梱された Typst で
	// build/obj/<name>.typ をコンパイルするため、フォントの解決条件を
	// scripts/container-build.sh の typst 呼び出しに合わせる必要がある。
	// 詳細は README の「エディタ内での Typst プレビュー」参照。

	// ビルドの --font-path 相当。イメージ内 /opt/fonts と同じフォントを参照
	// する(`make fonts` がイメージから .fonts/ へ書き出す)。書き出す前は
	// 和文フォントが解決できずプレビューが代替フォントになる。
	"tinymist.fontPaths": ["${workspaceFolder}/.fonts"],
	// ビルドの --ignore-system-fonts 相当。ローカルにインストールされた同名
	// フォントが混ざってプレビューとビルドで見た目がずれるのを防ぐ。
	"tinymist.systemFonts": false,
	// build/obj/<name>.typ は pandoc の生成物なので、整形しても次の再生成で
	// 失われる(かつ整形結果は成果物に影響しない)。
	"tinymist.formatterMode": "disable",
	// PDF は make(コンテナ内の typst)が唯一の生成元。拡張側から別条件で
	// 書き出すと成果物がどちらのものか分からなくなる。
	"tinymist.exportPdf": "never"
}
